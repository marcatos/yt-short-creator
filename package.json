{
  "name": "yt-short-creator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "workers": "tsx scripts/run-workers.ts",
    "build": "next build",
    "start": "next start",
    "daemon:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/daemon/start.ps1",
    "daemon:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/daemon/stop.ps1",
    "daemon:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/daemon/restart.ps1",
    "daemon:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/daemon/status.ps1",
    "daemon:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/daemon/logs.ps1",
    "daemon:install-autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/daemon/install-autostart.ps1",
    "daemon:uninstall-autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/daemon/uninstall-autostart.ps1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node -e \"require('fs').mkdirSync('./data',{recursive:true})\" && drizzle-kit migrate"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "drizzle-orm": "^0.43.1",
    "googleapis": "^174.0.1",
    "next": "^15.3.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
